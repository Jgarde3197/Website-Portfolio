{
  "name": "jefferson-garde-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node --use-system-ca node_modules/vite/bin/vite.js",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "node --use-system-ca node_modules/vite/bin/vite.js preview",
    "test:contact": "node --experimental-strip-types scripts/test-contact.mjs",
    "test:chat": "node --experimental-strip-types scripts/test-chat.mjs",
    "test:api-runtime": "node scripts/test-api-runtime.mjs",
    "serve": "node --use-system-ca --experimental-strip-types scripts/serve.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.1.0",
    "@phosphor-icons/react": "^2.1.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.1",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^14.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.5"
  }
}
